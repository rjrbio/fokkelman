# porque SÍ queremos que se suba a Netlify

# Scripts Python de desarrollo
*.py
*.pyc
__pycache__/

# Documentación de desarrollo
GUIA_*.md
RESUMEN_*.md
INICIO_*.md

# Scripts de inicio local
inicio.bat
inicio.sh

# Node modules
node_modules/

# Git
.git/
.gitignore

